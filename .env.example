# ===========================================
# Game Twenti - Production Environment
# ===========================================
# Copy this file to .env.production and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=production

# Session Secret (CHANGE THIS! Generate with: openssl rand -base64 48)
SESSION_SECRET=your-super-secret-session-key-change-in-production

# PostgreSQL Database (used by docker-compose internally)
POSTGRES_DB=gametwenti
POSTGRES_USER=gametwenti
POSTGRES_PASSWORD=your-strong-db-password-here

# DATABASE_URL is set automatically by docker-compose.yml
# If using external database (e.g., Supabase), uncomment and set:
# DATABASE_URL=postgresql://user:password@host:5432/database
# DIRECT_URL=postgresql://user:password@host:5432/database

# Admin Default Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here

# Email Configuration (for order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Domain Configuration
DOMAIN=yourdomain.com
